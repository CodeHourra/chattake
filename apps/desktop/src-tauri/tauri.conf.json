{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "ChatTake",
  "version": "0.2.0",
  "identifier": "com.chattake.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun --bun run dev",
    "beforeBuildCommand": "bun --bun run build:tauri"
  },
  "app": {
    "windows": [
      {
        "title": "有得 · AI 对话知识库",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "resources": {
      "../../../packages/sidecar/dist/chattake-sidecar": "chattake-sidecar",
      "../../../packages/mcp-server/dist/chattake-mcp": "chattake-mcp"
    },
    "macOS": {
      "bundleName": "有得"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlENzEzM0RBODkxQ0Y3QTEKUldTaDl4eUoyak54blV5a2huR0h2dUxML3ozYXE1enhtTHlMbzc1NEVaakJld010N1NmUXFjdXgK",
      "endpoints": [
        "https://github.com/CodeHourra/chattake/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
